{
  "expo": {
    "name": "NotaKu",
    "slug": "notaku",
    "owner": "zanracle",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notaku",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.notaku.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NotaKu memakai kamera untuk memotret struk belanja.",
        "NSPhotoLibraryUsageDescription": "NotaKu memakai galeri untuk melampirkan foto struk.",
        "NSFaceIDUsageDescription": "NotaKu memakai Face ID untuk membuka aplikasi."
      }
    },
    "android": {
      "package": "com.notaku.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B3D31",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3D31",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 148
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NotaKu memakai kamera untuk memotret struk belanja.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NotaKu memakai Face ID untuk membuka aplikasi."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2b1e4bdd-23da-43b6-b25a-06c53b51248b"
      }
    }
  }
}
