{
  "expo": {
    "name": "NotaKu",
    "slug": "notaku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notaku",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.notaku.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NotaKu memakai kamera untuk memotret struk belanja.",
        "NSPhotoLibraryUsageDescription": "NotaKu memakai galeri untuk melampirkan foto struk.",
        "NSFaceIDUsageDescription": "NotaKu memakai Face ID untuk membuka aplikasi."
      }
    },
    "android": {
      "package": "com.notaku.app",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NotaKu memakai kamera untuk memotret struk belanja."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NotaKu memakai Face ID untuk membuka aplikasi."
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
